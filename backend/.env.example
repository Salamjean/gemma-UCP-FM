# ===== Serveur =====
PORT=3000
FRONTEND_URL=http://localhost:5173

# ===== Base de données (la même que le projet Laravel gemma) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gemma
DB_USERNAME=root
DB_PASSWORD=

# ===== Jetons de connexion (JWT) =====
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=8h
JWT_EXPIRES_IN_REMEMBER=30d

# ===== Fichiers partagés avec Laravel (photos…) =====
# Dossier public/ du projet Laravel : les images y sont enregistrées (assets/uploads/...)
LARAVEL_PUBLIC_PATH=

# ===== SMS aux patients (1smsafrica) =====
SMS_ACTIF=true
YELLIKA_API_URL=
YELLIKA_API_KEY=
YELLIKA_SENDER_ID=GestPatient
PATIENT_APP_URL=

# ===== Emails (mot de passe oublié) =====
MAIL_ACTIF=true
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="GEMMA"
